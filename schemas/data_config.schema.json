{
  "$comment": "Generated from hyperencoder.datamodels.data_config.DataConfig",
  "$defs": {
    "CropConfig": {
      "additionalProperties": false,
      "description": "Configuration for data cropping/augmentation.",
      "properties": {
        "crop_ratio": {
          "default": 8,
          "description": "Ratio for cropping the data",
          "maximum": 32,
          "minimum": 1,
          "title": "Crop Ratio",
          "type": "integer"
        },
        "original_crop_length": {
          "default": 47,
          "description": "Original length for cropping operations",
          "minimum": 1,
          "title": "Original Crop Length",
          "type": "integer"
        },
        "random_crop": {
          "default": true,
          "description": "Whether to apply random cropping to the data",
          "title": "Random Crop",
          "type": "boolean"
        }
      },
      "title": "CropConfig",
      "type": "object"
    },
    "DatasetEntry": {
      "additionalProperties": false,
      "description": "Configuration for a single dataset entry.",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional name for the dataset",
          "title": "Name"
        },
        "path": {
          "description": "Path to the dataset directory or file",
          "examples": [
            "/path/to/dataset",
            "./data/pre_encoded",
            "${oc.env:DATA_ROOT}/pre_encoded_babyslakh"
          ],
          "title": "Path",
          "type": "string"
        },
        "weight": {
          "default": 1.0,
          "description": "Weight for this dataset when combining multiple datasets",
          "minimum": 0.0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "path"
      ],
      "title": "DatasetEntry",
      "type": "object"
    }
  },
  "$id": "https://hyperencoder.ai/schemas/data_config.schema.json",
  "additionalProperties": false,
  "description": "Configuration for hyperencoder data loading and processing.\n\nThis replaces the previous JSON-based data configurations with\na modern, type-safe, validated configuration system.",
  "properties": {
    "_target_": {
      "default": "hyperencoder.data.latent.LatentsForHyperEncoderDataset",
      "description": "Target class for instantiating the dataset",
      "examples": [
        "hyperencoder.data.latent.LatentsForHyperEncoderDataset",
        "hyperencoder.data.audio.AudioDataset"
      ],
      "title": "Target",
      "type": "string"
    },
    "batch_size": {
      "default": 32,
      "description": "Number of samples per batch",
      "maximum": 512,
      "minimum": 1,
      "title": "Batch Size",
      "type": "integer"
    },
    "cache_dir": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Directory for caching processed data",
      "title": "Cache Dir"
    },
    "crop_config": {
      "anyOf": [
        {
          "$ref": "#/$defs/CropConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Configuration for data cropping/augmentation"
    },
    "dataset_type": {
      "default": "latents_for_hyperencoder",
      "description": "Type of dataset to load",
      "enum": [
        "latents_for_hyperencoder",
        "audio_dataset",
        "pre_encoded_dataset"
      ],
      "title": "Dataset Type",
      "type": "string"
    },
    "datasets": {
      "description": "List of dataset configurations to load",
      "items": {
        "$ref": "#/$defs/DatasetEntry"
      },
      "title": "Datasets",
      "type": "array"
    },
    "file_extension": {
      "default": ".pt",
      "description": "File extension for dataset files",
      "examples": [
        ".pt",
        ".npy",
        ".wav",
        ".mp3"
      ],
      "title": "File Extension",
      "type": "string"
    },
    "loading_strategy": {
      "default": "lazy",
      "description": "Strategy for loading data into memory",
      "enum": [
        "lazy",
        "eager",
        "memory_mapped"
      ],
      "title": "Loading Strategy",
      "type": "string"
    },
    "max_files": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Maximum number of files to load (for debugging)",
      "title": "Max Files"
    },
    "normalize": {
      "default": true,
      "description": "Whether to normalize the data",
      "title": "Normalize",
      "type": "boolean"
    },
    "num_workers": {
      "default": 8,
      "description": "Number of CPU workers for the DataLoader",
      "maximum": 32,
      "minimum": 0,
      "title": "Num Workers",
      "type": "integer"
    },
    "path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Single dataset path (alternative to datasets list)",
      "title": "Path"
    },
    "persistent_workers": {
      "default": false,
      "description": "Whether to keep DataLoader workers persistent between epochs",
      "title": "Persistent Workers",
      "type": "boolean"
    },
    "random_seed": {
      "default": 42,
      "description": "Random seed for reproducibility in data loading",
      "minimum": 0,
      "title": "Random Seed",
      "type": "integer"
    },
    "recursive": {
      "default": true,
      "description": "Whether to search for files recursively in directories",
      "title": "Recursive",
      "type": "boolean"
    },
    "shuffle": {
      "default": true,
      "description": "Whether to shuffle the data during training",
      "title": "Shuffle",
      "type": "boolean"
    },
    "split_type": {
      "default": "auto",
      "description": "How to split the data into train/val/test sets",
      "enum": [
        "auto",
        "manual",
        "none"
      ],
      "title": "Split Type",
      "type": "string"
    },
    "test_split_pct": {
      "default": 0.1,
      "description": "Percentage of data to use for testing",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Test Split Pct",
      "type": "number"
    },
    "train_split_pct": {
      "default": 0.8,
      "description": "Percentage of data to use for training",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Train Split Pct",
      "type": "number"
    },
    "use_cache": {
      "default": false,
      "description": "Whether to use cached data if available",
      "title": "Use Cache",
      "type": "boolean"
    },
    "val_split_pct": {
      "default": 0.1,
      "description": "Percentage of data to use for validation",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Val Split Pct",
      "type": "number"
    }
  },
  "title": "DataConfig",
  "type": "object"
}